# Local testing only (npm run setup:local writes the real .dev.vars for you). Never deployed.
TOKEN_MAXIME=AAAAA-BBBBB-CCCCC-DDDDD
TOKEN_JANIN=JJJJJ-KKKKK-LLLLL-MMMMM
TOKEN_KATHRIN=EEEEE-FFFFF-GGGGG-HHHHH
TOKEN_LINUS=NNNNN-PPPPP-QQQQQ-RRRRR
TOKEN_OSKAR=SSSSS-TTTTT-UUUUU-VVVVV
TOKEN_ANNALENA=WWWWW-XXXXX-YYYYY-ZZZZZ
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
VAPID_SUBJECT=mailto:test@freigang.test
# Lets test/run.mjs catch outgoing pushes in a mock push service.
PUSH_TEST_URL=http://127.0.0.1:9911
# Lets test/run.mjs answer the weather requests itself (mock). Never set this in the real deployment: without it the app asks api.open-meteo.com.
WEATHER_API=http://127.0.0.1:9912/v1/forecast
